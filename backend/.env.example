APP_ENV=development
AUTH_MODE=local
PROVIDER_MODE=fixture
STORAGE_MODE=sqlite
AWS_REGION=eu-west-1
# Optional local profile name. Use the ECS task role after deployment.
AWS_PROFILE=
DATABASE_PATH=../.data/clearance-gap.db
SCENARIOS_PATH=../scenarios
DECIDER_URL=http://127.0.0.1:8099
# Required for live mode. Set an accessible EU model/inference-profile identifier.
BEDROCK_MODEL_ID=
# Required when AUTH_MODE=cognito. No local identity is allowed in production.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# Full HTTPS login origin; required in production along with a nonempty API scope.
COGNITO_REQUIRED_SCOPE=
# Cloud storage configuration, used with STORAGE_MODE=dynamodb.
DYNAMODB_TABLE=clearance-gap-sessions
SCENARIO_BUCKET=
# One API coordinator. Admission is serialized and each user's daily start/resume quota is durable.
MAX_ACTIVE_SESSIONS=1
MAX_DAILY_RUNS_PER_USER=20
