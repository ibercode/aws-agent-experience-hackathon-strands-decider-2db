{
  "id": "incorrect-readback",
  "version": "3",
  "title": "Incorrect readback",
  "description": "The pilot reads back a different action. Watch the assistant detect the mismatch and follow the controller’s correction.",
  "objective": "Track the instruction, readback and correction while keeping aircraft observations separate.",
  "durationMs": 34000,
  "initialDistanceM": 50,
  "observationGap": false,
  "initialSetup": {
    "airport": "Fictional demonstration airport",
    "runway": "36",
    "taxiway": "Alpha",
    "aircraft": "AIR123",
    "reciprocalRunway": "18"
  },
  "script": [
    {
      "id": "instruction",
      "atMs": 2000,
      "type": "trainee_instruction",
      "actor": "trainee",
      "text": "AIR123, hold short of runway 36.",
      "action": "hold"
    },
    {
      "id": "wrong-readback",
      "atMs": 5000,
      "type": "pilot_readback",
      "actor": "pilot",
      "text": "Lining up runway 36, AIR123."
    },
    {
      "id": "correction",
      "atMs": 14000,
      "type": "trainee_instruction",
      "actor": "trainee",
      "text": "Negative, AIR123. Hold short of runway 36.",
      "action": "hold",
      "presets": [
        "partial",
        "complete"
      ]
    },
    {
      "id": "corrected-readback",
      "atMs": 18000,
      "type": "pilot_readback",
      "actor": "pilot",
      "text": "Holding short of runway 36, AIR123.",
      "presets": [
        "partial",
        "complete"
      ]
    },
    {
      "id": "verify",
      "atMs": 26000,
      "type": "trainee_observation_check",
      "actor": "trainee",
      "text": "Checks the surface observation for AIR123.",
      "presets": [
        "complete"
      ]
    }
  ],
  "learningObjectives": [
    "Notice incorrect readback",
    "Recognise a later correction",
    "Separate pilot words from observed movement"
  ],
  "sourceReferences": [
    "https://www.faa.gov/Air_Traffic/publications/atpubs/atc_html/chap3_section_7.html"
  ],
  "note": "Experimental ATC assistance demonstration with scripted human controller and pilot roles. Only scenario-allowed observations are available to the assistant. Legacy event names are retained for saved-session compatibility."
}
